NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://eleanor:eleanor@localhost:5432/eleanor

OPENAI_API_KEY=sk-your-key
OPENAI_ADMIN_KEY=sk-your-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

CORS_ORIGINS=http://localhost:4200

# Development-only convenience.
AUTH_DEV_BYPASS=true
AUTH_DEV_USER_ID=local-developer

# Required when AUTH_DEV_BYPASS=false.
AUTH_ISSUER_URL=https://identity.example.com/
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_AUDIENCE=https://api.eleanor.example.com